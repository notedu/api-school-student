{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": ["backend/**/*.ts", "backend/**/*.json"],
      "options": {
        "semi": true,
        "singleQuote": false
      }
    }
  ]
}
